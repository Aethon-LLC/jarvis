# Copy to .env for local dev — never commit .env
# All values in 1Password

TELEGRAM_TOKEN=          # from @BotFather
TELEGRAM_CHAT_ID=        # your personal Telegram chat ID (see README)
ANTHROPIC_API_KEY=       # from console.anthropic.com
OPENAI_API_KEY=          # from platform.openai.com — for Whisper voice transcription

# Voice trade logging integration with Trading OS (Sprint 5 D7+)
# Both Coolify-side and Vercel-side must have JARVIS_WEBHOOK_SECRET
# set to the SAME value (generate with: openssl rand -hex 32).
JARVIS_WEBHOOK_SECRET=   # shared secret for /api/voice/log-trade auth
JARVIS_CLERK_USER_ID=    # your Clerk user ID (lookup at usetradingos.com/settings/account)
TRADING_OS_API=          # default https://usetradingos.com/api/voice/log-trade — override only for staging
